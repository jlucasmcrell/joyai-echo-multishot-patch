{
  "_comment": "IC-LoRA V2V motion-transfer smoke test. Derived from the stock ComfyUI template video_ltx2_3_ic_lora.json, with the MoGe depth subgraph replaced by core Canny (no download required) and the prompt-enhancer branch removed. API/prompt format - POST to /prompt as {\"prompt\": <this minus _comment keys>}. Target 512x320: with reference_downscale_factor=2 both dims MUST be divisible by 64 (544-height would be invalid). Canny runs at target res and LTXVAddGuide downscales it to 256x160 internally, matching Lightricks' own reference pipeline; canny computed directly at 256x160 was verified by offline preview to fragment the subject silhouette. Thresholds 0.15/0.45 also chosen by offline preview.",
  "1": {
    "class_type": "LoadVideo",
    "_meta": { "title": "Source clip (motion donor)" },
    "inputs": { "file": "iclora_v2v_src_dog.mp4" }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "_meta": { "title": "Split source to frames" },
    "inputs": { "video": ["1", 0] }
  },
  "3": {
    "class_type": "ImageFromBatch",
    "_meta": { "title": "Trim to exactly 97 frames (8n+1)" },
    "inputs": { "image": ["2", 0], "batch_index": 0, "length": 97 }
  },
  "4": {
    "class_type": "ImageScale",
    "_meta": { "title": "Scale to target res 512x320 (node downscales to 256x160 internally)" },
    "inputs": {
      "image": ["3", 0],
      "upscale_method": "area",
      "width": 512,
      "height": 320,
      "crop": "disabled"
    }
  },
  "5": {
    "class_type": "Canny",
    "_meta": { "title": "Canny control track - thresholds calibrated by offline preview" },
    "inputs": { "image": ["4", 0], "low_threshold": 0.15, "high_threshold": 0.45 }
  },
  "6": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "LTX 2.3 distilled fp8 (all-in-one)" },
    "inputs": { "ckpt_name": "LTX 2.3\\ltx-2.3-22b-distilled-fp8.safetensors" }
  },
  "7": {
    "class_type": "LTXVAudioVAELoader",
    "_meta": { "title": "Audio VAE" },
    "inputs": { "ckpt_name": "LTX 2.3\\ltx-2.3-22b-distilled-fp8.safetensors" }
  },
  "8": {
    "class_type": "LTXAVTextEncoderLoader",
    "_meta": { "title": "Gemma 3 12B text encoder" },
    "inputs": {
      "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
      "ckpt_name": "LTX 2.3\\ltx-2.3-22b-distilled-fp8.safetensors",
      "device": "default"
    }
  },
  "9": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "IC-LoRA Union Control (ref0.5)" },
    "inputs": {
      "model": ["6", 0],
      "lora_name": "ltx23\\ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors",
      "strength_model": 1.0
    }
  },
  "10": {
    "class_type": "GetICLoRAParameters",
    "_meta": { "title": "Read reference_downscale_factor (=2) from LoRA metadata" },
    "inputs": { "iclora_model": ["9", 0] }
  },
  "11": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive - DIFFERENT subject than the source" },
    "inputs": {
      "text": "A sleek black panther sits on a patterned rug in a grand old drawing room, then rises smoothly to its feet and pads out of frame to the right. An antique armchair and a small side table stand behind it, tall windows with sheer curtains let in cool grey daylight, a potted palm fills the corner. Glossy black fur with muscle rippling across the shoulders as it moves, long tail low and swaying. Muted desaturated colours, quiet room tone, the faint click of claws on hardwood.",
      "clip": ["8", 0]
    }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative (inert at cfg 1.0, required by graph)" },
    "inputs": {
      "text": "blurry, out of focus, low contrast, washed out colors, excessive noise, distorted proportions, extra limbs, deformed",
      "clip": ["8", 0]
    }
  },
  "13": {
    "class_type": "LTXVConditioning",
    "_meta": { "title": "Stamp frame rate onto conditioning" },
    "inputs": { "positive": ["11", 0], "negative": ["12", 0], "frame_rate": 25.0 }
  },
  "14": {
    "class_type": "EmptyLTXVLatentVideo",
    "_meta": { "title": "512x320 x 97 - both dims /64 for downscale factor 2" },
    "inputs": { "width": 512, "height": 320, "length": 97, "batch_size": 1 }
  },
  "15": {
    "class_type": "LTXVEmptyLatentAudio",
    "_meta": { "title": "Empty audio lane (joint AV model)" },
    "inputs": {
      "frames_number": 97,
      "frame_rate": 25,
      "batch_size": 1,
      "audio_vae": ["7", 0]
    }
  },
  "16": {
    "class_type": "LTXVAddGuide",
    "_meta": { "title": "IC-LoRA reference tokens (the actual control injection)" },
    "inputs": {
      "positive": ["13", 0],
      "negative": ["13", 1],
      "vae": ["6", 2],
      "latent": ["14", 0],
      "image": ["5", 0],
      "frame_idx": 0,
      "strength": 1.0,
      "iclora_parameters": ["10", 0]
    }
  },
  "17": {
    "class_type": "LTXVConcatAVLatent",
    "_meta": { "title": "Concat AV latent" },
    "inputs": { "video_latent": ["16", 2], "audio_latent": ["15", 0] }
  },
  "18": {
    "class_type": "KSampler",
    "_meta": { "title": "8-step distilled sampler, cfg 1.0" },
    "inputs": {
      "model": ["9", 0],
      "seed": 42,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "linear_quadratic",
      "positive": ["16", 0],
      "negative": ["16", 1],
      "latent_image": ["17", 0],
      "denoise": 1.0
    }
  },
  "19": {
    "class_type": "LTXVSeparateAVLatent",
    "_meta": { "title": "Split AV latent" },
    "inputs": { "av_latent": ["18", 0] }
  },
  "20": {
    "class_type": "LTXVCropGuides",
    "_meta": { "title": "Strip the appended reference tokens back off" },
    "inputs": { "positive": ["16", 0], "negative": ["16", 1], "latent": ["19", 0] }
  },
  "21": {
    "class_type": "VAEDecodeTiled",
    "_meta": { "title": "Decode video" },
    "inputs": {
      "samples": ["20", 2],
      "vae": ["6", 2],
      "tile_size": 768,
      "overlap": 64,
      "temporal_size": 4096,
      "temporal_overlap": 64
    }
  },
  "22": {
    "class_type": "LTXVAudioVAEDecode",
    "_meta": { "title": "Decode audio" },
    "inputs": { "samples": ["19", 1], "audio_vae": ["7", 0] }
  },
  "23": {
    "class_type": "CreateVideo",
    "_meta": { "title": "Mux" },
    "inputs": { "images": ["21", 0], "fps": 25.0, "audio": ["22", 0] }
  },
  "24": {
    "class_type": "SaveVideo",
    "_meta": { "title": "Save" },
    "inputs": {
      "video": ["23", 0],
      "filename_prefix": "video/ICLORA_V2V_smoketest",
      "format": "auto",
      "codec": "auto"
    }
  }
}
